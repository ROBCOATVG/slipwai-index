    "codegraph": [
      {
        "version": "1.0.0",
        "file": "https://github.com/ROBCOATVG/slipwai-extension-codegraph/releases/download/v1.0.0/codegraph-1.0.0.tar.gz",
        "sha256": "c6acbf038e863c86dcc8b61c10fb36af56ea70ff59d6f5e075c3186c5558cfea",
        "kind": "extension",
        "extension": {
          "key": "codegraph",
          "name": "CodeGraph",
          "description": "Indexes the codebase into a local knowledge graph your coding agent can query over MCP, so it can trace callers, dependencies, and the blast radius of a change across files.",
          "kind": "extension",
          "core": ">=9.0,<10",
          "publisher": "ROBCOATVG",
          "tags": [
            "dev-tooling"
          ],
          "ignore": ".codegraph/\n",
          "hooks": {
            "init": "init.py",
            "after-stage": {
              "run": "hooks/sync.py",
              "stages": [
                "implement",
                "converge"
              ],
              "budget": "30s"
            },
            "check": "hooks/check.py"
          }
        },
        "publisher": "ROBCOATVG",
        "description": "Indexes the codebase into a local knowledge graph your coding agent can query over MCP, so it can trace callers, dependencies, and the blast radius of a change across files.",
        "tags": [
          "dev-tooling"
        ]
      }
    ],
