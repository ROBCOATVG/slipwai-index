{
  "name": "typescript",
  "version": "1.2.0",
  "file": "https://github.com/ROBCOATVG/slipwai-language-typescript/releases/download/v1.2.0/typescript-1.2.0.tar.gz",
  "sha256": "2f2516c83face3698f2864212ab639d7aa7dfbd77e1bd1372b2eccb16f868da8",
  "kind": "language",
  "language": {
    "name": "typescript",
    "core": ">=9.0,<10",
    "order": 10,
    "family": "typescript",
    "backends": {
      "typescript": {
        "label": "TypeScript — Node and npm workspaces, ESLint, `tsc`, Vitest",
        "targets": [
          "none",
          "existing",
          "aws",
          "azure"
        ],
        "options": {
          "http": [
            "none",
            "fastify"
          ],
          "auth": [
            "none",
            "keycloak",
            "cognito",
            "entra",
            "auth0"
          ],
          "users": [
            "none",
            "keycloak",
            "cognito",
            "auth0"
          ],
          "persistence": [
            "memory",
            "sqlite",
            "postgres"
          ],
          "write-model": [
            "events",
            "state"
          ]
        },
        "defaults": {
          "http": "fastify"
        }
      }
    },
    "axes": {
      "http": {
        "fastify": {
          "label": "Fastify — JSON API, schema-parsed at the edge",
          "capabilities": [
            "http-fastify"
          ],
          "features": [
            "fastify"
          ],
          "containers": [],
          "migrations": false,
          "integration-suite": false,
          "targets": [
            "none",
            "existing",
            "aws",
            "azure"
          ],
          "app-in-compose": true,
          "repository-owned": [
            "packages/api-client"
          ],
          "web-app-owned": [
            "src/routes",
            "tests/routes"
          ]
        }
      }
    },
    "frontends": {
      "react-vite": {
        "label": "React and Vite — a TypeScript browser app, Biome, Vitest and Testing Library",
        "stack": "TypeScript/React/Vite",
        "gate": "Biome, TypeScript and React component tests",
        "capabilities": [
          "frontend",
          "typescript",
          "react",
          "vite"
        ],
        "marked": [
          "vite.config.ts",
          "src/main.tsx",
          "src/App.tsx",
          "tests/App.test.tsx"
        ],
        "features": {
          "users-keycloak": {
            "files": "features/users-keycloak",
            "owned": [
              "src/auth",
              "tests/auth"
            ],
            "dependencies": {
              "oidc-client-ts": "3.5.0",
              "react-oidc-context": "3.3.1"
            },
            "where": "`src/auth/users.tsx`, react-oidc-context over oidc-client-ts"
          }
        },
        "design": {
          "tokens": "src/styles/tokens.css",
          "base": "src/styles/base.css",
          "shell": "src/App.tsx",
          "entry": "src/main.tsx",
          "imports": [
            "import './styles/tokens.css';\n",
            "import './styles/base.css';\n"
          ],
          "route": "src/routes/Home.tsx"
        }
      }
    }
  },
  "publisher": "ROBCOATVG",
  "answers": [
    "npm_workspace",
    "browser_apps"
  ]
}
