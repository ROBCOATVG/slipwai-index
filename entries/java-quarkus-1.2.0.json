{
  "name": "java-quarkus",
  "version": "1.2.0",
  "file": "https://github.com/ROBCOATVG/slipwai-language-java-quarkus/releases/download/v1.2.0/java-quarkus-1.2.0.tar.gz",
  "sha256": "c3b5ef2efd191ab0e6248d4e5ca9598c2feb3b7c2e53cafb9f2468e82e553307",
  "kind": "language",
  "language": {
    "name": "java-quarkus",
    "core": ">=9.0,<10",
    "order": 40,
    "family": "java",
    "requires": {
      "java": ">=1.2,<2"
    },
    "backends": {
      "java-quarkus": {
        "framework": "quarkus",
        "label": "Java — Quarkus owns startup (Agroal, Flyway, SmallRye Health, OIDC); Maven, Checkstyle/PMD/SpotBugs, JUnit 5",
        "targets": [
          "none",
          "existing",
          "aws",
          "azure"
        ],
        "options": {
          "http": [
            "none",
            "quarkus-rest"
          ],
          "auth": [
            "none",
            "keycloak",
            "cognito",
            "entra",
            "auth0"
          ],
          "users": [
            "none",
            "keycloak",
            "cognito",
            "auth0"
          ],
          "persistence": [
            "memory",
            "sqlite",
            "postgres"
          ],
          "write-model": [
            "events",
            "state"
          ]
        },
        "defaults": {
          "http": "quarkus-rest"
        }
      }
    },
    "axes": {
      "http": {
        "quarkus-rest": {
          "label": "Quarkus REST — JSON API on the framework's own HTTP layer, with SmallRye Health serving the readiness probe",
          "capabilities": [
            "http-quarkus-rest"
          ],
          "features": [
            "quarkus-rest"
          ],
          "containers": [],
          "migrations": false,
          "integration-suite": false,
          "targets": [
            "none",
            "existing",
            "aws",
            "azure"
          ],
          "app-in-compose": true,
          "note": "Dropping it takes SmallRye Health with it: the readiness probe is the framework's."
        }
      }
    }
  },
  "publisher": "ROBCOATVG"
}
