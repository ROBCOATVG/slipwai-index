    "order": 40,
    "family": "java",
    "requires": {
      "java": ">=1.2,<2"
    },
    "backends": {
      "java-spring": {
        "framework": "spring-boot",
        "label": "Java — Spring Boot owns startup (HikariCP, Flyway, Actuator, Spring Security); Maven, Checkstyle/PMD/SpotBugs, JUnit 5",
        "targets": [
          "none",
          "existing",
          "aws",
          "azure"
        ],
        "options": {
          "http": [
            "none",
            "spring-web"
          ],
          "auth": [
            "none",
            "keycloak",
            "cognito",
            "entra",
            "auth0"
          ],
          "users": [
            "none",
            "keycloak",
            "cognito",
            "auth0"
          ],
          "persistence": [
            "memory",
            "sqlite",
            "postgres"
          ],
          "write-model": [
            "events",
            "state"
          ]
        },
        "defaults": {
          "http": "spring-web"
        }
      }
    },
    "axes": {
      "http": {
        "spring-web": {
          "label": "Spring MVC — JSON API on Tomcat over virtual threads, with Actuator serving the readiness probe",
          "capabilities": [
            "http-spring-web"
          ],
          "features": [
            "spring-web"
          ],
          "containers": [],
          "migrations": false,
          "integration-suite": false,
          "targets": [
            "none",
            "existing",
            "aws",
            "azure"
          ],
          "app-in-compose": true,
          "note": "Dropping it takes Actuator with it: the readiness probe is the framework's."
        }
      }
    }
  },
  "publisher": "ROBCOATVG"
